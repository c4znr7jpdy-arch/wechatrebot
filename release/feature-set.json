{
  "schema_version": 1,
  "features": [
    {
      "module": "astrbot_plugin_angel_heart",
      "display_name": "长期记忆",
      "ownership": "third-party",
      "configuration": "page",
      "description": "由回复引擎的原生会话上下文与天使之心共同维护连续对话，可在专属页面管理群聊和私聊记忆。"
    },
    {
      "module": "astrbot_plugin_qq_group_daily_analysis",
      "display_name": "群聊分析",
      "ownership": "third-party",
      "configuration": "schema",
      "description": "汇总群聊活跃时段、热门话题、成员称号和精彩发言，支持手动分析与按群定时生成报告。"
    },
    {
      "module": "astrbot_plugin_music",
      "display_name": "点歌",
      "ownership": "third-party",
      "configuration": "none",
      "description": "点歌能力已按交付环境完成适配，无需额外配置。"
    },
    {
      "module": "jiang_short_drama",
      "display_name": "短剧",
      "ownership": "owner",
      "configuration": "page-and-global-schedule-center",
      "description": "播放中间页由服务端统一提供；专属页面保留短剧推送定时任务、内容类型和目标群聊等设置。"
    },
    {
      "module": "jiang_commands",
      "display_name": "常用指令",
      "ownership": "owner",
      "configuration": "schema"
    },
    {
      "module": "jiang_schedule",
      "display_name": "定时任务",
      "ownership": "owner",
      "configuration": "page-and-global-schedule-center"
    }
  ],
  "shared_runtime": [
    {
      "source": "data/plugins/_nonebot_stubs.py",
      "purpose": "legacy module compatibility"
    },
    {
      "source": "ai_plugin/ai_plugin",
      "purpose": "command and schedule function library",
      "excluded": [
        ".env.prod",
        "legacy_nonebot2",
        "venv",
        "logs",
        "test files"
      ]
    }
  ]
}
