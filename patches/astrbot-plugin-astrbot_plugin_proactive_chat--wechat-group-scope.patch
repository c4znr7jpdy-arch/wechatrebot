diff --git a/core/wechat_group_scope.py b/core/wechat_group_scope.py
new file mode 100644
index 0000000..1371d0a
--- /dev/null
+++ b/core/wechat_group_scope.py
@@ -0,0 +1,202 @@
+"""Use the manager's account-scoped grants for WeChat proactive group chats."""
+from __future__ import annotations
+
+import asyncio
+from contextvars import ContextVar
+import json
+from pathlib import Path
+
+from astrbot.api import logger
+from astrbot.core.platform.platform import PlatformStatus
+from astrbot.core.platform.wechat_group_policy import group_plugins
+
+
+MODULE = "astrbot_plugin_proactive_chat"
+_generation_account = ContextVar("proactive_wechat_generation_account", default=None)
+
+
+def _policy_path() -> Path:
+    return Path.cwd().parent.parent / "data/manager/group-policies.json"
+
+
+def _group_platform(plugin, session_id: str):
+    parsed = plugin._parse_session_id(session_id)
+    if not parsed or parsed[1] != "GroupMessage" or not parsed[2].endswith("@chatroom"):
+        return None
+    return plugin.context.get_platform_inst(parsed[0])
+
+
+def is_wechat_group(plugin, session_id: str) -> bool:
+    parsed = plugin._parse_session_id(session_id)
+    if not parsed or parsed[1] != "GroupMessage" or not parsed[2].endswith("@chatroom"):
+        return False
+    platform = _group_platform(plugin, session_id)
+    # A temporarily missing WeChat platform must not revive the legacy list.
+    return platform is None or platform.meta().name == "aiocqhttp"
+
+
+def remember_group_account(plugin, event) -> None:
+    """A new live group event confirms an account switch before timers restart."""
+    session_id = event.unified_msg_origin
+    if not is_wechat_group(plugin, session_id):
+        return
+    account = str(event.get_self_id() or "").strip()
+    if account:
+        accounts = getattr(plugin, "_wechat_group_accounts", {})
+        accounts[plugin._parse_session_id(session_id)[0]] = account
+        plugin._wechat_group_accounts = accounts
+
+
+def group_scope_ready(plugin, session_id: str) -> bool:
+    parsed = plugin._parse_session_id(session_id)
+    return bool(parsed and parsed[0] in getattr(plugin, "_wechat_group_accounts", {}))
+
+
+def bound_group_account(plugin, session_id: str) -> str | None:
+    """Keep a pending group task bound to the account that created it."""
+    if not is_wechat_group(plugin, session_id):
+        return None
+    platform_id = plugin._parse_session_id(session_id)[0]
+    payload = getattr(plugin, "session_data", {}).get(session_id, {})
+    account = str(payload.get("self_id") or "").strip()
+    if not account and payload.get("next_trigger_time"):
+        raise PermissionError("Persisted proactive group task has no account binding")
+    generation = _generation_account.get()
+    if generation and generation[0] == session_id:
+        if account and account != generation[1]:
+            raise PermissionError("Proactive group account changed during generation")
+        account = generation[1]
+    confirmed = getattr(plugin, "_wechat_group_accounts", {}).get(platform_id, "")
+    if account and confirmed and account != confirmed:
+        raise PermissionError("Proactive group account changed")
+    account = account or confirmed
+    if not account:
+        raise PermissionError("Proactive group account is unconfirmed")
+    return account
+
+
+def group_is_allowed(plugin, session_id: str) -> bool:
+    """Reuse the manager's authoritative grant rules, never the legacy group list."""
+    try:
+        if not is_wechat_group(plugin, session_id):
+            return False
+        platform = _group_platform(plugin, session_id)
+        if platform is None or platform.status != PlatformStatus.RUNNING:
+            return False
+        parsed = plugin._parse_session_id(session_id)
+        allowed = group_plugins(
+            _policy_path(), bound_group_account(plugin, session_id), parsed[2],
+            plugin.context.get_config(session_id).get("plugin_set", ["*"]),
+            plugin.context.get_all_stars(),
+        )
+        return bool(allowed and MODULE in allowed)
+    except (AttributeError, KeyError, PermissionError, TypeError, ValueError):
+        logger.debug("Proactive group scope could not be confirmed; denied.")
+        return False
+
+
+def configured_group_sessions(plugin) -> list[str]:
+    """Discover explicit manager grants for previously confirmed platform accounts."""
+    if not plugin.config.get("group_settings", {}).get("enable", False):
+        return []
+    try:
+        payload = json.loads(_policy_path().read_text(encoding="utf-8-sig"))
+        if payload.get("schema_version") != 1 or not isinstance(payload.get("accounts"), dict):
+            return []
+        sessions = []
+        for platform_id, account in getattr(plugin, "_wechat_group_accounts", {}).items():
+            entry = payload["accounts"].get(account, {})
+            groups = entry.get("groups", {}) if isinstance(entry, dict) else {}
+            if not isinstance(groups, dict):
+                continue
+            for target in groups:
+                if not isinstance(target, str) or not target.endswith("@chatroom"):
+                    continue
+                session_id = f"{platform_id}:GroupMessage:{target}"
+                if group_is_allowed(plugin, session_id):
+                    sessions.append(session_id)
+        return sorted(set(sessions))
+    except (OSError, AttributeError, TypeError, ValueError):
+        logger.debug("Proactive group discovery could not read manager policy; denied.")
+        return []
+
+
+async def discover_group_sessions(plugin) -> list[str]:
+    """Resolve live accounts before seeding startup tasks or exposing group sessions."""
+    accounts = {}
+    for platform in plugin.context.platform_manager.get_insts():
+        if platform.meta().name != "aiocqhttp" or platform.status != PlatformStatus.RUNNING:
+            continue
+        try:
+            login = await asyncio.wait_for(platform.bot.get_login_info(), timeout=5)
+            account = str(login.get("user_id") or "").strip()
+            if account:
+                accounts[platform.meta().id] = account
+        except Exception as exc:
+            logger.warning("Proactive group account discovery failed: %s", type(exc).__name__)
+    plugin._wechat_group_accounts = accounts
+    sessions = configured_group_sessions(plugin)
+    async with plugin.data_lock:
+        for session_id in sessions:
+            platform_id = plugin._parse_session_id(session_id)[0]
+            # An old task for a different account remains blocked until a real
+            # message from the new account resets that chat's state.
+            plugin.session_data.setdefault(session_id, {})["self_id"] = accounts[platform_id]
+    return sessions
+
+
+async def refresh_group_scope(plugin) -> None:
+    """Wait briefly for platform connections without polling indefinitely."""
+    for attempt in range(12):
+        sessions = await discover_group_sessions(plugin)
+        settings = plugin.config.get("group_settings", {})
+        if not settings.get("enable", False):
+            return
+        await plugin._init_jobs_from_data(managed_groups_only=True)
+        for session_id in sessions:
+            if (session_id not in plugin.auto_trigger_timers
+                    and not plugin.last_message_times.get(session_id, 0)):
+                await plugin._setup_auto_trigger_for_session_config(settings, session_id)
+        platforms = [p for p in plugin.context.platform_manager.get_insts()
+                     if p.meta().name == "aiocqhttp"]
+        if platforms and all(p.meta().id in plugin._wechat_group_accounts for p in platforms):
+            return
+        if attempt < 11:
+            await asyncio.sleep(5)
+    logger.info("Proactive group discovery is waiting for a connected WeChat account.")
+
+
+def schedule_group_scope_refresh(plugin) -> None:
+    """Coalesce startup and platform-loaded notifications into one discovery task."""
+    if not plugin.config.get("group_settings", {}).get("enable", False):
+        return
+    task = getattr(plugin, "_wechat_group_scope_task", None)
+    if task is None or task.done():
+        plugin._wechat_group_scope_task = asyncio.create_task(refresh_group_scope(plugin))
+
+
+def pin_group_generation(plugin, session_id: str):
+    if is_wechat_group(plugin, session_id):
+        return _generation_account.set((session_id, bound_group_account(plugin, session_id)))
+    return None
+
+
+def reset_group_generation(token) -> None:
+    if token is not None:
+        _generation_account.reset(token)
+
+
+async def authorize_group_chat(plugin, session_id: str) -> bool:
+    """Recheck identity and current grants before preparing context or calling a model."""
+    if not is_wechat_group(plugin, session_id):
+        return True
+    if not group_is_allowed(plugin, session_id):
+        return False
+    from astrbot.core.platform.wechat_background_policy import background_event
+    try:
+        account = bound_group_account(plugin, session_id)
+        await background_event(plugin.context, session_id, MODULE, account_id=account)
+        return True
+    except PermissionError:
+        logger.info("Proactive group permission revoked or account changed; generation skipped.")
+        return False
