@@ -0,0 +1,55 @@
+"""Decode WeChat file metadata without trusting attachment names as paths."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import PurePosixPath
+import re
+import xml.etree.ElementTree as ET
+
+from .event_normalizer import integer, scalar
+
+
+@dataclass(frozen=True, slots=True)
+class FileAttachment:
+    name: str
+    size: int
+    attach_id: str
+
+
+def parse_file_attachment(data) -> FileAttachment | None:
+    app = None
+    for field in ("content_xml", "real_content", "content"):
+        content = scalar(data.get(field)).strip()
+        if not content or len(content) > 1048576 or "<!DOCTYPE" in content.upper():
+            continue
+        try:
+            tree = ET.fromstring(content)
+        except ET.ParseError:
+            continue
+        app = tree if tree.tag == "appmsg" else tree.find(".//appmsg")
+        if app is not None:
+            break
+    if app is not None:
+        if app.findtext("type") != "6":
+            return None
+        name = app.findtext("title") or ""
+        extension = app.findtext("appattach/fileext") or ""
+        size = integer(app.findtext("appattach/totallen"))
+        attach_id = app.findtext("appattach/attachid") or ""
+    else:
+        if integer(data.get("appType") or data.get("type")) != 6:
+            return None
+        name = scalar(data.get("file_name") or data.get("fileName") or data.get("filename"))
+        extension = scalar(data.get("fileext"))
+        size = integer(data.get("total_len") or data.get("totalLen"))
+        attach_id = scalar(data.get("attachid") or data.get("attachId"))
+    name = PurePosixPath(name.replace("\\", "/")).name
+    name = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", name).strip(" .")
+    extension = extension.strip().lstrip(".")
+    if not PurePosixPath(name).suffix and re.fullmatch(r"[A-Za-z0-9]{1,12}", extension):
+        name += "." + extension
+    name = name or "attachment.bin"
+    suffix = PurePosixPath(name).suffix[:13]
+    if len(name) > 100:
+        name = name[:100-len(suffix)] + suffix
+    return FileAttachment(name=name, size=max(0, size), attach_id=attach_id)
