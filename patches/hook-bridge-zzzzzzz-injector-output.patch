diff --git a/hook_41827_astrbot_bridge/src/hook_bridge/injector_output.py b/hook_41827_astrbot_bridge/src/hook_bridge/injector_output.py
new file mode 100644
index 0000000..95e21d1
--- /dev/null
+++ b/hook_41827_astrbot_bridge/src/hook_bridge/injector_output.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+from typing import Any
+
+from wechatrebot_manager.customer_logs import sanitize_log_text
+
+
+logger = logging.getLogger(__name__)
+_READ_SIZE = 16 * 1024
+_STDERR_LIMIT = 4096
+
+
+class InjectorOutput:
+    """Own nonblocking pipe reads; stdout is discarded and stderr stays bounded."""
+
+    def __init__(self, process: Any) -> None:
+        self._pipes = {
+            name: pipe for name in ("stdout", "stderr")
+            if (pipe := getattr(process, name, None)) is not None
+        }
+        self._active: dict[str, int] = {}
+        self._stderr = bytearray()
+        self._stderr_truncated = False
+        self.task: asyncio.Task[None] | None = None
+
+    def start(self) -> None:
+        # Python 3.13 supports nonblocking anonymous pipes on Windows. Never
+        # mix os.read with BufferedReader.read or leave blocking reads in threads.
+        for name, pipe in self._pipes.items():
+            try:
+                descriptor = pipe.fileno()
+                os.set_blocking(descriptor, False)
+            except (OSError, ValueError) as exc:
+                raise RuntimeError("injector output pipe cannot be made nonblocking") from exc
+            self._active[name] = descriptor
+        self.task = asyncio.create_task(self._drain(), name="injector-output")
+
+    def check(self) -> None:
+        if self.task is not None and self.task.done():
+            if self.task.cancelled():
+                raise RuntimeError("injector output reader was unexpectedly cancelled")
+            self.task.result()
+
+    def _read(self, name: str) -> bool:
+        descriptor = self._active.get(name)
+        if descriptor is None:
+            return False
+        try:
+            data = os.read(descriptor, _READ_SIZE)
+        except BlockingIOError:
+            return False
+        except OSError as exc:
+            raise RuntimeError("injector output pipe could not be read") from exc
+        if not data:
+            self._active.pop(name, None)
+            return False
+        if name == "stderr":
+            self._stderr.extend(data)
+            if len(self._stderr) > _STDERR_LIMIT:
+                del self._stderr[:-_STDERR_LIMIT]
+                self._stderr_truncated = True
+        return True
+
+    async def _drain(self) -> None:
+        while self._active:
+            received = False
+            for name in tuple(self._active):
+                received = self._read(name) or received
+            # Read both streams once per turn, even under continuous output.
+            await asyncio.sleep(0 if received else 0.02)
+
+    def stderr_detail(self) -> str:
+        self.check()
+        # Child exit does not guarantee EOF: a descendant can inherit its pipe.
+        # Collect available final bytes without waiting for writers to close.
+        for _ in range(16):
+            if not self._read("stderr"):
+                break
+        raw = bytes(self._stderr)
+        if self._stderr_truncated:
+            # A cut credential label must never turn its remaining value into
+            # unlabeled diagnostic text. Omit that first incomplete line.
+            raw = raw.partition(b"\n")[2]
+        return sanitize_log_text(raw.decode("utf-8", errors="replace")).strip()[:500]
+
+    async def close(self) -> None:
+        if self.task is not None:
+            if not self.task.done():
+                self.task.cancel()
+            await asyncio.gather(self.task, return_exceptions=True)
+        self._active.clear()
+        for pipe in self._pipes.values():
+            try:
+                pipe.close()
+            except OSError:
+                logger.warning("injector output pipe close failed")
+        self._pipes.clear()
