+def _safe_card_image_url(value: object) -> str:
+    url = str(value or "").strip()
+    if not url or len(url) > 2048 or any(ord(char) < 32 for char in url):
+        return _DEFAULT_COVER
+    try:
+        parsed = urlsplit(url)
+        hostname = (parsed.hostname or "").rstrip(".").lower()
+        parsed.port
+        try:
+            address = ipaddress.ip_address(hostname)
+        except ValueError:
+            labels = hostname.split(".")
+            public_host = (
+                len(labels) >= 2
+                and bool(re.search(r"[a-z]", labels[-1]))
+                and hostname != "localhost"
+                and not hostname.endswith((".localhost", ".local"))
+                and all(
+                    re.fullmatch(
+                        r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",
+                        label,
+                    )
+                    for label in labels
+                )
+            )
+        else:
+            public_host = address.is_global
+        if (
+            parsed.scheme != "https"
+            or not public_host
+            or parsed.username
+            or parsed.password
+        ):
+            return _DEFAULT_COVER
+    except ValueError:
+        return _DEFAULT_COVER
+    return url
+
+
