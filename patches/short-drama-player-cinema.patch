+    _wait_catalog_request(base)
+    deadline = time.monotonic() + 4
+    with build_opener(_NoRedirect()).open(request, timeout=3) as response:
+        chunks, size = [], 0
+        while size <= MAX_BODY_BYTES:
+            # read1 performs at most one socket read, so slow trickles cannot keep
+            # the scan occupied indefinitely. A final socket read may take 3s.
+            if time.monotonic() >= deadline:
+                raise TimeoutError('catalog read deadline exceeded')
+            chunk = response.read1(min(65536, MAX_BODY_BYTES + 1 - size))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            size += len(chunk)
+        raw = b''.join(chunks)
+    if len(raw) > MAX_BODY_BYTES:
+        raise ValueError('catalog response too large')
+    result = json.loads(raw)
+    if not isinstance(result, dict):
+        raise ValueError('invalid catalog response')
+    return result
+
+
+def _catalog_item(record: object, source_name: str, *, short_only: bool = True, fingerprint: str = "") -> dict | None:
+    if not isinstance(record, dict) or (short_only and not re.search(r'短剧|漫剧', str(record.get('type_name') or ''))):
+        return None
+    title = str(record.get('vod_name') or '').strip()
+    if not title or len(title) > 300:
+        return None
+    # Multiple providers can publish several playback lines; keep one HTTPS HLS line.
+    best = None
+    for line in str(record.get('vod_play_url') or '').split('$$$'):
+        episodes = []
+        for raw in line.split('#'):
+            name, separator, url = raw.partition('$')
+            if not separator:
+                continue
+            url = url.strip()
+            if _valid_public_https_url(url) and re.search(r'\.m3u8(?:$|[?#])', url, re.I):
+                episodes.append({'name': name[:200] or f'第{len(episodes) + 1}集', 'url': url})
+        if not episodes or len(episodes) > MAX_EPISODES:
+            continue
+        if fingerprint and not any(hashlib.sha256(episode['url'].encode()).hexdigest() == fingerprint for episode in episodes):
+            continue
+        item = {'title': title, 'category': str(record.get('type_name') or '')[:100],
+                'cover': str(record.get('vod_pic') or '').replace('http://', 'https://', 1)[:2048],
+                'year': str(record.get('vod_year') or '')[:20],
+                'actor': str(record.get('vod_actor') or '')[:300],
+                'source': source_name, 'episode_count': len(episodes), 'episodes': episodes}
+        payload, error = _validate_payload({'v': 1, 'kind': 'recommendations', 'heading': '猜你喜欢', 'items': [item]})
+        if not error and payload:
+            if best is None or len(item['episodes']) > len(best['episodes']):
+                best = item
+    return best
+
+
+def _recommendation_kind(category: object, title: object = '') -> str:
+    """Only explicit AI/comic dramas and live short-drama categories qualify."""
+    import unicodedata
+    name = re.sub(r'\s+', '', unicodedata.normalize('NFKC', str(category or ''))).casefold()
+    if '漫剧' in name or re.search(r'(?<![a-z])ai(?:短剧|剧|动画|动漫)', name):
+        return 'ai'
+    if '短剧' not in name or re.search(r'动漫|动画', name):
+        return ''
+    label = unicodedata.normalize('NFKC', str(title or '')).casefold()
+    tagged_ai = re.search(r'(?:^|[\s(\[])ai(?:$|[\s)\]])|(?<![a-z])ai(?:短剧|漫剧|剧)', label)
+    return 'ai' if tagged_ai else 'live'
+
+
+def _recommendation_candidates(items: list[dict], limit: int) -> list[dict]:
+    """Reserve two AI slots per live slot, including in the bounded shared pool."""
+    ai = [item for item in items if item.get('recommendation_kind') == 'ai']
+    live = [item for item in items if item.get('recommendation_kind') == 'live']
+    selected = []
+    for index in range((limit + 2) // 3):
+        selected.extend(ai[index * 2:index * 2 + 2] + live[index:index + 1])
+    return selected[:limit]
+
+
+class RecommendationCatalog:
+    """Public source metadata only; never enumerate private stored user selections."""
+    # Same sources already maintained by jiang_short_drama/search.py.
+    SOURCES = (('暴风资源', 'https://bfzyapi.com/api.php/provide/vod/'),
+               ('非凡资源', 'https://cj.ffzyapi.com/api.php/provide/vod/'),
+               ('量子资源', 'https://cj.lziapi.com/api.php/provide/vod/'))
+
+    def __init__(self, state: StateStore):
+        import threading
+        self.state = state
+        self.lock = threading.Lock()
+        self.cached: list[dict] = []
+        self.refresh_at = 0.0
+        self.expires_at = 0.0
+        self.sample_at = 0.0
+        self.max_candidates = 96
+        self.max_cache_bytes = 8 * 1024 * 1024
+
+    def _load(self) -> list[dict]:
+        found = {}
+        sources = list(self.SOURCES)
+        secrets.SystemRandom().shuffle(sources)
+        deadline = time.monotonic() + 8
+        completed = False
+        for source_name, base in sources:
+            try:
+                if time.monotonic() >= deadline:
+                    break
+                listing = _catalog_json(base, ac='list')
+                categories = {'ai': [], 'live': []}
+                for category in listing.get('class', []):
+                    if isinstance(category, dict) and (kind := _recommendation_kind(category.get('type_name'))):
+                        categories[kind].append(category.get('type_id'))
+                if not any(categories.values()):
+                    completed = True
+                for kind, identifiers in categories.items():
+                    if not identifiers or time.monotonic() >= deadline:
+                        continue
+                    try:
+                        category = secrets.choice(identifiers)
+                        details = _catalog_json(base, ac='detail', t=category, pg=1)
+                        page_count = max(1, min(100000, int(details.get('pagecount') or 1)))
+                        page = secrets.randbelow(page_count) + 1
+                        if page != 1:
+                            if time.monotonic() >= deadline:
+                                break
+                            details = _catalog_json(base, ac='detail', t=category, pg=page)
+                        completed = True
+                        for record in details.get('list', [])[:100]:
+                            if not isinstance(record, dict) or not (record_kind := _recommendation_kind(record.get('type_name'), record.get('vod_name'))):
+                                continue
+                            item = _catalog_item(record, source_name, short_only=False)
+                            if item:
+                                item['recommendation_kind'] = record_kind
+                                item['recommendation_id'] = hashlib.sha256(_source_identity(item)[0].encode()).hexdigest()[:16]
+                                found.setdefault(item['recommendation_id'], item)
+                    except (OSError, ValueError, TypeError, KeyError, AttributeError):
+                        LOGGER.warning('recommendation category unavailable: %s/%s', source_name, kind)
+                if (sum(item['recommendation_kind'] == 'ai' for item in found.values()) >= 8
+                        and sum(item['recommendation_kind'] == 'live' for item in found.values()) >= 4):
+                    break
+            except (OSError, ValueError, TypeError, KeyError, AttributeError):
+                LOGGER.warning('recommendation catalog source unavailable: %s', source_name)
+        if not completed:
+            raise OSError('recommendation catalogs unavailable')
+        return _recommendation_candidates(list(found.values()), self.max_candidates)
+
+    def _select(self, excluded: set[str] | None) -> list[dict]:
+        if time.time() >= self.expires_at:
+            return []
+        available = [item for item in self.cached if not excluded or item['recommendation_id'] not in excluded]
+        if excluded is not None:
+            secrets.SystemRandom().shuffle(available)
+        selected, size = [], 2048
+        for item in _recommendation_candidates(available, 12):
+            size += len(json.dumps(item, ensure_ascii=False).encode('utf-8'))
+            if size > MAX_BODY_BYTES:
+                break
+            selected.append(item)
+        return selected
+
+    def get(self, excluded: set[str] | None = None) -> list[dict]:
+        now = time.time()
+        selected = self._select(excluded)
+        needs_sample = excluded is not None and len(selected) < 12 and now >= self.sample_at
+        if now < self.refresh_at and not needs_sample:
+            return selected
+        # A refresh is shared across requests; busy callers use the still-valid cache.
+        if not self.lock.acquire(blocking=False):
+            return selected
+        try:
+            if time.time() < self.refresh_at and not needs_sample:
+                return self._select(excluded)
+            self.sample_at = time.time() + 3
+            try:
+                items = self._load()
+            except OSError:
+                if selected:
+                    return selected
+                raise
+            if not items:
+                self.refresh_at = time.time() + 30
+                return self._select(excluded)
+            previous = self.cached if now < self.expires_at else []
+            combined = {item['recommendation_id']: item for item in previous}
+            expires = [self.expires_at] if previous else []
+            for item in items:
+                if item['recommendation_id'] in combined:
+                    continue
+                token, expires_at = self.state.put({'v': 1, 'kind': 'recommendations',
+                                                   'heading': item['title'], 'items': [dict(item)]})
+                item['selection_token'] = token
+                expires.append(expires_at)
+                combined[item['recommendation_id']] = item
+            # Keep only bounded public metadata; request-specific exclusions are never stored.
+            size, bounded = 0, []
+            for item in _recommendation_candidates(list(reversed(list(combined.values()))), self.max_candidates):
+                item_size = len(json.dumps(item, ensure_ascii=False).encode('utf-8'))
+                if len(bounded) >= self.max_candidates or size + item_size > self.max_cache_bytes:
+                    break
+                bounded.append(item)
+                size += item_size
+            self.cached = list(reversed(bounded))
+            self.expires_at = min(expires)
+            self.refresh_at = time.time() + min(300, self.state.ttl_seconds / 2)
+            return self._select(excluded)
+        finally:
+            self.lock.release()
+
+def _source_identity(item: dict) -> tuple[str, str, str, str]:
+    """Compare works across providers without treating commentary as a version."""
+    import unicodedata
+    def normalized(value: object) -> str:
+        return re.sub(r'[\W_]+', '', unicodedata.normalize('NFKC', str(value or '')).casefold())
+    title = normalized(item.get('title'))
+    year_match = re.search(r'(?:19|20)\d{2}', str(item.get('year') or ''))
+    if not year_match:
+        year_match = re.search(r'(?<=[\s(（])(?:19|20)\d{2}(?=[)）]?$)', str(item.get('title') or ''))
+    year = year_match.group(0) if year_match else ''
+    if year and len(title) > len(year) and title.endswith(year):
+        title = title[:-len(year)]
+    category = normalized(item.get('category'))
+    if re.search(r'动漫|动画|漫剧', category):
+        category = '动画'
+    elif '短剧' in category:
+        category = '短剧'
+    elif '剧' in category and not category.endswith('片'):
+        category = '电视剧'
+    elif '电影' in category or category.endswith('片'):
+        category = '电影'
+    elif '综艺' in category:
+        category = '综艺'
+    actors = re.split(r'[,，、/\s]+', str(item.get('actor') or '').strip())
+    return title, year, category, normalized(actors[0]) if actors else ''
+
+
+class SelectionResolver:
+    """Recover compact-link metadata from the original fixed product source."""
+    SOURCES = dict(RecommendationCatalog.SOURCES + (
+        ('红牛资源', 'https://www.hongniuzy2.com/api.php/provide/vod/from/hnm3u8/'),
+        ('极速资源', 'https://jszyapi.com/api.php/provide/vod'),
+        ('百度云资源', 'https://api.apibdzy.com/api.php/provide/vod/'),
+        ('金鹰资源', 'https://jyzyapi.com/provide/vod/from/jinyingm3u8/at/json'),
+        ('飘零资源', 'https://p2100.net/api.php/provide/vod/'),
+        ('360资源', 'https://360zy.com/api.php/provide/vod/'),
+        ('无尽资源', 'https://api.wujinapi.com/api.php/provide/vod/'),
+        ('魔都资源', 'https://www.mdzyapi.com/api.php/provide/vod/'),
+        ('新浪资源', 'https://api.xinlangapi.com/xinlangapi.php/provide/vod/from/xlm3u8/'),
+    ))
+
+    def __init__(self):
+        import threading
+        self.lock = threading.Lock()
+        self.slots = threading.BoundedSemaphore(8)
+        self.scan_slots = threading.BoundedSemaphore(2)
+        self.scan_requests = threading.BoundedSemaphore(24)
+        self.scan_inflight = {}
+        self.scan_times = []
+        self.cache = {}
+        self.alternative_cache = {}
+        self.alternative_cache_limit = 64
+        self.alternative_cache_bytes = 8 * 1024 * 1024
+
+    def _validate_request(self, title: str, source: str, fingerprint: str) -> None:
+        if not title or len(title) > 300 or source not in self.SOURCES or not re.fullmatch(r'[0-9a-f]{64}', fingerprint):
+            raise ValueError('invalid metadata request')
+
+    def _records(self, title: str, source: str) -> list:
+        if not self.slots.acquire(timeout=4):
+            raise OSError('metadata resolver busy')
+        try:
+            details = _catalog_json(self.SOURCES[source], ac='detail', wd=title, pg=1)
+            records = details.get('list', [])
+            if not isinstance(records, list):
+                raise ValueError('invalid source records')
+            return records[:100]
+        finally:
+            self.slots.release()
+
+    def _scan(self, key: tuple, load):
+        """Share identical scans and bound both active fanout and waiting callers."""
+        from concurrent.futures import Future, TimeoutError as FutureTimeout
+        if not self.scan_requests.acquire(blocking=False):
+            raise OSError('catalog scan busy')
+        owner = False
+        try:
+            with self.lock:
+                future = self.scan_inflight.get(key)
+                if future is None:
+                    now = time.monotonic()
+                    self.scan_times = [started for started in self.scan_times if started > now - 60]
+                    if len(self.scan_times) >= 120:
+                        raise OSError('catalog scan request limit reached')
+                    self.scan_times.append(now)
+                    future = self.scan_inflight[key] = Future()
+                    owner = True
+            if not owner:
+                try:
+                    return future.result(timeout=CATALOG_SCAN_RESULT_SECONDS)
+                except FutureTimeout as error:
+                    raise OSError('catalog scan wait timed out') from error
+            try:
+                if not self.scan_slots.acquire(timeout=CATALOG_SCAN_QUEUE_SECONDS):
+                    raise OSError('catalog scan busy')
+                try:
+                    result = load()
+                finally:
+                    self.scan_slots.release()
+            except BaseException as error:
+                future.set_exception(error)
+                raise
+            else:
+                future.set_result(result)
+                return result
+            finally:
+                with self.lock:
+                    self.scan_inflight.pop(key, None)
+        finally:
+            self.scan_requests.release()
+
+    def get(self, title: str, source: str, fingerprint: str) -> dict | None:
+        self._validate_request(title, source, fingerprint)
+        key = (title, source, fingerprint)
+        with self.lock:
+            cached = self.cache.get(key)
+            if cached and cached[0] > time.time():
+                return cached[1]
+        item = None
+        for record in self._records(title, source):
+            if not isinstance(record, dict) or str(record.get('vod_name') or '').strip() != title:
+                continue
+            item = _catalog_item(record, source, short_only=False, fingerprint=fingerprint)
+            if item:
+                break
+        with self.lock:
+            now = time.time()
+            self.cache = {key: value for key, value in self.cache.items() if value[0] > now}
+            if len(self.cache) >= 200:
+                self.cache.pop(next(iter(self.cache)))
+            self.cache[key] = (now + (300 if item else 30), item)
+        return item
+
+    def _source_items(self, title: str, source: str, fingerprint: str) -> list[dict] | None:
+        try:
+            items = []
+            for record in self._records(title, source):
+                if not isinstance(record, dict):
+                    continue
+                metadata = ' '.join(str(record.get(field) or '') for field in ('vod_name', 'type_name', 'vod_remarks'))
+                if re.search(r'解说|预告|花絮|幕后|片段', metadata):
+                    continue
+                item = _catalog_item(record, source, short_only=False, fingerprint=fingerprint)
+                if item:
+                    items.append(item)
+            return items
+        except (OSError, ValueError, TypeError, KeyError, AttributeError):
+            LOGGER.warning('alternative catalog source unavailable: %s', source)
+            return None
+
+    def _matching_sources(self, candidates: list[dict], hint: dict, source: str) -> list[dict]:
+        wanted = _source_identity(hint)
+        anchor = next((item for item in candidates if item['source'] == source and all(not value or value == _source_identity(item)[index] for index, value in enumerate(wanted))), None)
+        expected = list(_source_identity({**hint, **({key: value for key, value in anchor.items() if value} if anchor else {})}))
+        matching = [(item, _source_identity(item)) for item in candidates]
+        matching = [(item, identity) for item, identity in matching if identity[0] == expected[0]]
+        for index in range(1, 4):
+            if expected[index]:
+                matching = [(item, identity) for item, identity in matching if identity[index] == expected[index]]
+        # Old links can omit metadata. Never guess between different remakes or media kinds.
+        for index in range(1, 4):
+            if not expected[index]:
+                values = {identity[index] for _, identity in matching if identity[index]}
+                if len(values) > 1:
+                    return []
+                expected[index] = next(iter(values), '')
+        if not anchor and not (expected[1] or expected[3]):
+            return []
+        unique = {}
+        for item, identity in matching:
+            if any(expected[index] and identity[index] != expected[index] for index in range(1, 4)):
+                continue
+            previous = unique.get(item['source'])
+            if previous is None or len(item['episodes']) > len(previous['episodes']):
+                unique[item['source']] = item
+        ordered = sorted(unique.values(), key=lambda item: item['source'] != source)
+        bounded, size = [], 2048  # Leave room for the JSON envelope and heading.
+        for item in ordered:
+            size += len(json.dumps(item, ensure_ascii=False).encode('utf-8'))
+            if size > MAX_BODY_BYTES:
+                break
+            bounded.append(item)
+        return bounded
+
+    def alternatives(self, title: str, source: str, fingerprint: str, *, year: str = '', category: str = '', actor: str = '') -> list[dict]:
+        self._validate_request(title, source, fingerprint)
+        if len(year) > 20 or len(category) > 100 or len(actor) > 300:
+            raise ValueError('invalid work metadata')
+        key = (title, source, fingerprint, year, category, actor)
+        with self.lock:
+            cached = self.alternative_cache.get(key)
+            if cached and cached[0] > time.time():
+                return cached[1]
+        def load():
+            from concurrent.futures import ThreadPoolExecutor
+            with self.lock:
+                cached = self.alternative_cache.get(key)
+                if cached and cached[0] > time.time():
+                    return cached[1]
+            with ThreadPoolExecutor(max_workers=4) as executor:
+                search_title = re.sub(r'[\s(（]+(?:19|20)\d{2}[)）]?\s*$', '', title)
+                futures = [executor.submit(self._source_items, search_title, name, fingerprint if name == source else '') for name in self.SOURCES]
+                results = [future.result() for future in futures]
+            if all(result is None for result in results):
+                raise OSError('alternative catalogs unavailable')
+            candidates = [item for result in results if result is not None for item in result]
+            items = self._matching_sources(candidates, {'title': title, 'year': year, 'category': category, 'actor': actor}, source)
+            size = len(json.dumps(items, ensure_ascii=False).encode('utf-8'))
+            with self.lock:
+                now = time.time()
+                self.alternative_cache = {key: value for key, value in self.alternative_cache.items() if value[0] > now}
+                while self.alternative_cache and (len(self.alternative_cache) >= self.alternative_cache_limit or sum(value[2] for value in self.alternative_cache.values()) + size > self.alternative_cache_bytes):
+                    self.alternative_cache.pop(next(iter(self.alternative_cache)))
+                if size <= self.alternative_cache_bytes:
+                    lifetime = 30 if any(result is None for result in results) or not items else 300
+                    self.alternative_cache[key] = (now + lifetime, items, size)
+            return items
+        return self._scan(('alternatives', *key), load)
+
+
+class CatalogSearch:
+    """Bounded full-source search over the resolver's existing public catalogs."""
+
+    def __init__(self, resolver: SelectionResolver):
+        import threading
+        self.resolver = resolver
+        self.lock = threading.Lock()
+        self.cache = {}
+        self.cache_limit = 64
+        self.cache_bytes = 8 * 1024 * 1024
+
+    @staticmethod
+    def normalize_query(value: str) -> str:
+        import unicodedata
+        if not isinstance(value, str) or len(value) > 100 or any(ord(char) < 32 for char in value):
+            raise ValueError('invalid search query')
+        query = re.sub(r'\s+', ' ', unicodedata.normalize('NFKC', value)).strip()
+        query = re.sub(r'^(?:短剧|电视剧|电影|动漫|综艺)\s+', '', query)
+        # Chinese users commonly paste a title with spaces; preserve spaces in Latin titles.
+        query = re.sub(r'(?<=[\u3400-\u9fff])\s+(?=[\u3400-\u9fff])', '', query)
+        if not query or len(query) > 100 or not re.search(r'\w', query):
+            raise ValueError('invalid search query')
+        return query
+
+    def _cached(self, query: str) -> dict | None:
+        cached = self.cache.get(query)
+        return cached[1] if cached and cached[0] > time.time() else None
+
+    def _source_items(self, query: str, source: str) -> list[dict] | None:
+        try:
+            return [item for record in self.resolver._records(query, source)
+                    if (item := _catalog_item(record, source, short_only=False))]
+        except (OSError, ValueError, TypeError, KeyError, AttributeError):
+            LOGGER.warning('search catalog source unavailable: %s', source)
+            return None
+
+    def _response(self, query: str, results: list[tuple[str, list[dict] | None]]) -> dict:
+        from difflib import SequenceMatcher
+        wanted = _source_identity({'title': query})[0]
+        source_order = {source: index for index, source in enumerate(self.resolver.SOURCES)}
+        unique = {}
+        for source, items in results:
+            for item in items or []:
+                key = (source, *_source_identity(item))
+                previous = unique.get(key)
+                if previous is None or len(item['episodes']) > len(previous['episodes']):
+                    unique[key] = item
+
+        def rank(item):
+            title = _source_identity(item)[0]
+            similarity = SequenceMatcher(None, wanted, title).ratio()
+            match = 0 if title == wanted else 1 if wanted in title else 2
+            return match, -similarity, source_order[item['source']], item['title']
+
+        # Several catalogs use OR matching for individual Han characters. Keep
+        # their useful related titles without filling the page with unrelated hits.
+        candidates = sorted((item for item in unique.values()
+                             if rank(item)[0] < 2 or -rank(item)[1] >= 0.45), key=rank)
+        suggestions = list(dict.fromkeys(item['title'] for item in candidates
+                                        if _source_identity(item)[0] != wanted))[:6]
+        response = {'v': 1, 'kind': 'search', 'heading': f'搜索：{query}', 'query': query,
+                    'sources_total': len(self.resolver.SOURCES),
+                    'sources_searched': sum(items is not None for _, items in results),
+                    'failures': [source for source, items in results if items is None],
+                    'suggestions': suggestions, 'items': []}
+        size = len(json.dumps(response, ensure_ascii=False).encode('utf-8')) + 1024
