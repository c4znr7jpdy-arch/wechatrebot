+from urllib.request import HTTPRedirectHandler
+
+
+class _NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _catalog_json(base: str, **params: object) -> dict:
+    """Read bounded metadata from a fixed, existing product source, never media."""
+    from urllib.parse import urlencode
+    from urllib.request import Request, build_opener
+    request = Request(base + '?' + urlencode(params), headers={'User-Agent': 'ShortDramaPlayer/1.0'})
+    with build_opener(_NoRedirect()).open(request, timeout=4) as response:
+        raw = response.read(MAX_BODY_BYTES + 1)
+    if len(raw) > MAX_BODY_BYTES:
+        raise ValueError('catalog response too large')
+    result = json.loads(raw)
+    if not isinstance(result, dict):
+        raise ValueError('invalid catalog response')
+    return result
+
+
+def _catalog_item(record: object, source_name: str, *, short_only: bool = True, fingerprint: str = "") -> dict | None:
+    if not isinstance(record, dict) or (short_only and not re.search(r'短剧|漫剧', str(record.get('type_name') or ''))):
+        return None
+    title = str(record.get('vod_name') or '').strip()
+    if not title or len(title) > 300:
+        return None
+    # Multiple providers can publish several playback lines; keep one HTTPS HLS line.
+    best = None
+    for line in str(record.get('vod_play_url') or '').split('$$$'):
+        episodes = []
+        for raw in line.split('#'):
+            name, separator, url = raw.partition('$')
+            if not separator:
+                continue
+            url = url.strip()
+            if _valid_public_https_url(url) and re.search(r'\.m3u8(?:$|[?#])', url, re.I):
+                episodes.append({'name': name[:200] or f'第{len(episodes) + 1}集', 'url': url})
+        if not episodes or len(episodes) > MAX_EPISODES:
+            continue
+        if fingerprint and not any(hashlib.sha256(episode['url'].encode()).hexdigest() == fingerprint for episode in episodes):
+            continue
+        item = {'title': title, 'category': str(record.get('type_name') or '')[:100],
+                'cover': str(record.get('vod_pic') or '').replace('http://', 'https://', 1)[:2048],
+                'year': str(record.get('vod_year') or '')[:20],
+                'actor': str(record.get('vod_actor') or '')[:300],
+                'source': source_name, 'episode_count': len(episodes), 'episodes': episodes}
+        payload, error = _validate_payload({'v': 1, 'kind': 'recommendations', 'heading': '猜你喜欢', 'items': [item]})
+        if not error and payload:
+            if best is None or len(item['episodes']) > len(best['episodes']):
+                best = item
+    return best
+
+
+class RecommendationCatalog:
+    """Public source metadata only; never enumerate private stored user selections."""
+    # Same sources already maintained by jiang_short_drama/search.py.
+    SOURCES = (('暴风资源', 'https://bfzyapi.com/api.php/provide/vod/'),
+               ('非凡资源', 'https://cj.ffzyapi.com/api.php/provide/vod/'))
+
+    def __init__(self, state: StateStore):
+        import threading
+        self.state = state
+        self.lock = threading.Lock()
+        self.cached: list[dict] = []
+        self.refresh_at = 0.0
+        self.expires_at = 0.0
+
+    def _load(self) -> list[dict]:
+        found = {}
+        for source_name, base in self.SOURCES:
+            try:
+                listing = _catalog_json(base, ac='list')
+                categories = [category.get('type_id') for category in listing.get('class', [])
+                              if isinstance(category, dict) and re.search(r'短剧|漫剧', str(category.get('type_name') or ''))]
+                if not categories:
+                    continue
+                # Rotate category; latest 20 records provide a pool for random groups of three.
+                category = secrets.choice(categories)
+                details = _catalog_json(base, ac='detail', t=category, pg=1)
+                for record in details.get('list', [])[:100]:
+                    item = _catalog_item(record, source_name)
+                    if item:
+                        found.setdefault(item['title'], item)
+                if len(found) >= 6:
+                    break
+            except (OSError, ValueError, TypeError, KeyError, AttributeError):
+                LOGGER.warning('recommendation catalog source unavailable: %s', source_name)
+        return list(found.values())[:12]
+
+    def get(self) -> list[dict]:
+        now = time.time()
+        if now < self.refresh_at:
+            return self.cached if now < self.expires_at else []
+        # A refresh is shared across requests; busy callers use the still-valid cache.
+        if not self.lock.acquire(blocking=False):
+            return self.cached if now < self.expires_at else []
+        try:
+            if time.time() < self.refresh_at:
+                return self.cached if time.time() < self.expires_at else []
+            items = self._load()
+            if not items:
+                self.refresh_at = time.time() + 30
+                return self.cached if time.time() < self.expires_at else []
+            expires = []
+            for item in items:
+                token, expires_at = self.state.put({'v': 1, 'kind': 'recommendations',
+                                                   'heading': item['title'], 'items': [dict(item)]})
+                item['selection_token'] = token
+                expires.append(expires_at)
+            self.cached = items
+            self.expires_at = min(expires)
+            self.refresh_at = time.time() + min(300, self.state.ttl_seconds / 2)
+            return self.cached
+        finally:
+            self.lock.release()
