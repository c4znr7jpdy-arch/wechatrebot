@@ -0,0 +1,189 @@
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+from typing import Any, Callable
+from zoneinfo import ZoneInfo
+
+
+_ACCOUNT_ID = re.compile(r"^[A-Za-z0-9_.@:-]{1,128}$")
+_GROUP_ID = re.compile(r"^[A-Za-z0-9_.-]+@chatroom$")
+_CLOCK = re.compile(r"^(?:[01]\d|2[0-3]):[0-5]\d$")
+_DELIVERY_TYPES = frozenset({"reply", "proactive"})
+
+
+@dataclass(frozen=True, slots=True)
+class OutboundDecision:
+    allowed: bool
+    delivery: str
+    message: str
+
+
+def _atomic_json(path: Path, payload: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    descriptor, temporary_name = tempfile.mkstemp(
+        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
+    )
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
+            json.dump(payload, handle, ensure_ascii=False, indent=2)
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary_name, path)
+    except Exception:
+        try:
+            os.unlink(temporary_name)
+        except FileNotFoundError:
+            pass
+        raise
+
+
+def _minutes(value: str) -> int:
+    hour, minute = value.split(":", 1)
+    return int(hour) * 60 + int(minute)
+
+
+class OutboundGroupPolicy:
+    """Hot-read, fail-closed policy for group deliveries."""
+
+    def __init__(
+        self,
+        policy_path: str | Path,
+        *,
+        usage_path: str | Path | None = None,
+        now: Callable[[ZoneInfo], datetime] | None = None,
+    ) -> None:
+        self.policy_path = Path(policy_path).expanduser().resolve()
+        self.usage_path = (
+            Path(usage_path).expanduser().resolve()
+            if usage_path is not None
+            else self.policy_path.with_name("group-policy-usage.json")
+        )
+        self._now = now or (lambda zone: datetime.now(zone))
+        self._lock = asyncio.Lock()
+
+    @staticmethod
+    def _default() -> dict[str, Any]:
+        return {
+            "bot_enabled": True,
+            "reply_mode": "mention",
+            "quiet_hours": {
+                "enabled": False,
+                "start": "22:00",
+                "end": "08:00",
+                "timezone": "Asia/Shanghai",
+            },
+            "daily_limit": 3,
+        }
+
+    def _policy(self, account_id: str, group_id: str) -> dict[str, Any] | None:
+        try:
+            payload = json.loads(self.policy_path.read_text(encoding="utf-8-sig"))
+        except FileNotFoundError:
+            return self._default()
+        except (OSError, json.JSONDecodeError):
+            return None
+        if (
+            not isinstance(payload, dict)
+            or payload.get("schema_version") != 1
+            or not isinstance(payload.get("accounts"), dict)
+        ):
+            return None
+        account = payload["accounts"].get(account_id)
+        groups = account.get("groups") if isinstance(account, dict) else None
+        raw = groups.get(group_id) if isinstance(groups, dict) else None
+        if raw is None:
+            return self._default()
+        if not isinstance(raw, dict):
+            return None
+
+        policy = self._default()
+        for key in ("bot_enabled",):
+            if key in raw:
+                if not isinstance(raw[key], bool):
+                    return None
+                policy[key] = raw[key]
+        if "reply_mode" in raw:
+            if raw["reply_mode"] not in {"mention", "natural", "off"}:
+                return None
+            policy["reply_mode"] = raw["reply_mode"]
+        if "daily_limit" in raw:
+            value = raw["daily_limit"]
+            if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 100:
+                return None
+            policy["daily_limit"] = value
+        if "quiet_hours" in raw:
+            quiet = raw["quiet_hours"]
+            if not isinstance(quiet, dict):
+                return None
+            merged = dict(policy["quiet_hours"])
+            merged.update(quiet)
+            if (
+                not isinstance(merged.get("enabled"), bool)
+                or not isinstance(merged.get("start"), str)
+                or not _CLOCK.fullmatch(merged["start"])
+                or not isinstance(merged.get("end"), str)
+                or not _CLOCK.fullmatch(merged["end"])
+                or not isinstance(merged.get("timezone"), str)
+            ):
+                return None
+            policy["quiet_hours"] = merged
+        return policy
+
+    @staticmethod
+    def _in_quiet_hours(policy: dict[str, Any], now: datetime) -> bool:
+        quiet = policy["quiet_hours"]
+        if not quiet["enabled"]:
+            return False
+        start = _minutes(quiet["start"])
+        end = _minutes(quiet["end"])
+        current = now.hour * 60 + now.minute
+        if start == end:
+            return True
+        if start < end:
+            return start <= current < end
+        return current >= start or current < end
+
+    async def authorize(
+        self,
+        account_id: str,
+        group_id: str,
+        *,
+        delivery: str,
+        wake: bool = False,
+    ) -> OutboundDecision:
+        delivery = str(delivery or "").casefold()
+        if delivery not in _DELIVERY_TYPES:
+            delivery = "proactive"
+        account_id = str(account_id or "").strip()
+        group_id = str(group_id or "").strip()
+        if not _ACCOUNT_ID.fullmatch(account_id) or not _GROUP_ID.fullmatch(group_id):
+            return OutboundDecision(False, delivery, "无法确认当前机器人账号或目标群，消息已取消。")
+
+        async with self._lock:
+            # Read on every attempt so a manager save takes effect immediately.
+            policy = self._policy(account_id, group_id)
+            if policy is None:
+                return OutboundDecision(False, delivery, "群聊策略无法确认，消息已取消。")
+            if not policy["bot_enabled"]:
+                return OutboundDecision(False, delivery, "本群的机器人功能已关闭。")
+
+            if delivery == "reply":
+                mode = policy["reply_mode"]
+                if mode == "off":
+                    return OutboundDecision(False, delivery, "本群当前不允许机器人回复。")
+                if mode == "mention" and not wake:
+                    return OutboundDecision(False, delivery, "本群仅在明确点名时回复。")
+                return OutboundDecision(True, delivery, "reply allowed")
+
+            return OutboundDecision(True, delivery, "group delivery allowed")
+
+
+__all__ = ["OutboundDecision", "OutboundGroupPolicy"]
