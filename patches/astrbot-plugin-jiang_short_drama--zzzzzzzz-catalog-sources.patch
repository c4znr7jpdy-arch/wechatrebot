+    async def _wait_catalog_request(self, source: Source) -> None:
+        """Share Xinlang's request interval across this searcher's callers."""
+        if urlsplit(source.url).hostname != "api.xinlangapi.com":
+            return
+        deadline = time.monotonic() + 1.5
+        while True:
+            now = time.monotonic()
+            if now > deadline:
+                raise TimeoutError("catalog source request limit reached")
+            delay = self._xinlang_next_request - now
+            if delay <= 0:
+                # No await between checking and reserving in the robot's event loop.
+                self._xinlang_next_request = now + 1.1
+                return
+            if now + delay > deadline:
+                raise TimeoutError("catalog source request limit reached")
+            await asyncio.sleep(delay)
+
