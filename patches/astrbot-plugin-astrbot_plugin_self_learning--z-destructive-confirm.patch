+  async function runConfirmedAction(buttonEl, confirmation, handler) {
+    if (state.destructiveActionPending) return;
+    state.destructiveActionPending = true;
+    const disabled = buttonEl.disabled;
+    buttonEl.disabled = true;
+    buttonEl.classList.add("is-busy");
+    buttonEl.setAttribute("aria-busy", "true");
+    try {
+      if (!await showConfirm(...confirmation)) return;
+      await handler();
+    } catch (error) {
+      showToast(error.message || String(error), "error");
+    } finally {
+      state.destructiveActionPending = false;
+      buttonEl.disabled = disabled;
+      buttonEl.classList.remove("is-busy");
+      buttonEl.removeAttribute("aria-busy");
+    }
   }
 
