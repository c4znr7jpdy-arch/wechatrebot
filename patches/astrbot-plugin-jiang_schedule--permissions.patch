+def _can_manage_current_chat(event: AstrMessageEvent) -> bool:
+    """只信任 AstrBot 已确认的管理员语义，并隔离私聊会话。"""
+    sender_id = str(event.get_sender_id() or "").strip()
+    if event.is_private_chat():
+        # aiocqhttp 私聊 session_id 应与 sender_id 相同；不接受来源不明的
+        # 私聊会话，避免任务被写入其他人的发送目标。
+        session_id = str(event.get_session_id() or "").strip()
+        return bool(sender_id) and session_id == sender_id
+
+    # event.is_admin() 由 AstrBot 根据全局 admins_id 设置，是微信适配下
+    # 唯一始终可用的管理员依据。
+    if event.is_admin():
+        return True
+
+    # 其他平台若在框架 Group 对象中明确给出群主/管理员，也可以使用；
+    # 微信适配未提供这些字段时保持拒绝，绝不根据昵称或命令内容猜测。
+    group = getattr(getattr(event, "message_obj", None), "group", None)
+    event_group_id = str(event.get_group_id() or "").strip()
+    declared_group_id = str(getattr(group, "group_id", "") or "").strip()
+    if not sender_id or not group or not event_group_id or declared_group_id != event_group_id:
+        return False
+    owner_id = str(getattr(group, "group_owner", "") or "").strip()
+    if owner_id and sender_id == owner_id:
+        return True
+    admins = getattr(group, "group_admins", None)
+    return isinstance(admins, (list, tuple, set)) and sender_id in {
+        str(item).strip() for item in admins if str(item).strip()
+    }
+
+
+def _is_mutation_command(text: str) -> bool:
+    return any(
+        pattern.search(text)
+        for pattern in (_RE_DEL, _RE_ADD, _RE_BILI_SUB, _RE_BILI_UNSUB)
+    )
+
+
+def _permission_denied_message(event: AstrMessageEvent) -> str:
+    if event.is_private_chat():
+        return (
+            "这条私聊的身份与当前会话不一致，为保护其他聊天的定时任务，"
+            "本次没有修改。请在你和机器人的私聊窗口重新发送。"
+        )
+    return (
+        "只有机器人管理员可以添加、修改或删除群里的定时任务。"
+        "请让机器人管理员操作，或先在机器人后台把你的微信 ID 加入管理员名单。"
+    )
+
+
+def _shared_checkin_denied_message() -> str:
+    return (
+        "每日签到会使用机器人保存的站点账号，因此只有机器人管理员可以设置。"
+        "本次没有修改；如需使用，请联系机器人管理员。"
+    )
+
+
