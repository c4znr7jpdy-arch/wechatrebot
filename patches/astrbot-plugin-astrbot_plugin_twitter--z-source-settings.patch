+        if (
+            parsed.scheme.lower() not in schemes
+            or not hostname
+            or parsed.query
+            or parsed.fragment
+            or _contains_control_characters(value)
+        ):
+            return False
+        if not allow_credentials and (
+            parsed.username is not None or parsed.password is not None
+        ):
+            return False
+        if require_port and (port is None or not 1 <= port <= 65535):
+            return False
+        if require_port and parsed.path not in {"", "/"}:
+            return False
+        return True
