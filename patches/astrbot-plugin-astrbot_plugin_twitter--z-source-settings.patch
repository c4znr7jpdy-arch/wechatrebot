+    def _is_network_url(
+        value: str,
+        schemes: set[str],
+        *,
+        allow_credentials: bool = False,
+        require_port: bool = False,
+    ) -> bool:
+        if not value or any(char.isspace() for char in value):
+            return False
+        try:
+            parsed = urlsplit(value)
+            hostname = parsed.hostname
+            port = parsed.port
+        except ValueError:
