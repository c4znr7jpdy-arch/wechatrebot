diff --git a/model_manager.py b/model_manager.py
index a803740..3a4d8ba 100644
--- a/model_manager.py
+++ b/model_manager.py
@@ -461,6 +461,24 @@ class ImageModelManager:
             headers[str(profile.get("api_key_header") or "X-API-Key")] = api_key
         return headers
 
+    def format_error(self, profile: dict[str, Any], exc: Exception) -> str:
+        model = str(profile.get("model") or profile.get("name") or "生图模型")
+        host = urlparse(str(profile.get("base_url") or "")).hostname or ""
+        label = f"{model}（{host}）" if host else model
+        error_type = type(exc).__name__
+        if isinstance(exc, httpx.TimeoutException):
+            detail = "生图服务响应超时，请稍后重试"
+        elif isinstance(exc, httpx.RequestError):
+            detail = "连接生图服务失败，请检查网络或系统代理"
+            if not profile.get("trust_env", False):
+                detail += "；可在画图常用设置中启用系统代理"
+        else:
+            detail = str(exc).strip() or "生图请求失败"
+        secret = self._resolve_api_key(profile)
+        if secret:
+            detail = detail.replace(secret, "[已隐藏密钥]")
+        return f"{label}: {detail}（{error_type}）"
+
     def _require_api_key(self, profile: dict[str, Any]) -> str:
         if profile.get("auth_type") == "none":
             return ""
