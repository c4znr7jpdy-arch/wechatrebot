 };
 let lastUploadedVoiceId = '';
 let configEditVersion = 0;
+let configDirty = false;
+let activeEditorActions = 0;
+let editorSession = '';
+
+function publishEditorState() {
+  if (window.parent === window || !editorSession) return;
+  window.parent.postMessage({ channel: 'astrbot-plugin-page', kind: 'editor-state',
+    session: editorSession, dirty: configDirty, busy: activeEditorActions > 0 }, window.location.origin);
+}
+
+window.addEventListener('message', event => {
+  const message = event.data;
+  if (event.source !== window.parent || event.origin !== window.location.origin
+    || message?.channel !== 'astrbot-plugin-page' || message.kind !== 'editor-context'
+    || typeof message.session !== 'string' || !message.session || message.session.length > 80) return;
+  editorSession = message.session;
+  publishEditorState();
+});
+
+window.addEventListener('beforeunload', event => {
+  if (configDirty || activeEditorActions > 0) { event.preventDefault(); event.returnValue = ''; }
+});
+
+async function trackEditorAction(handler) {
+  activeEditorActions += 1;
+  publishEditorState();
+  try {
+    return await handler();
+  } finally {
+    activeEditorActions -= 1;
+    publishEditorState();
+  }
+}
 
