+def _bundled_node_runtimes() -> dict:
+    """Reuse the pinned Playwright wheel's Node without a separate installation."""
+    import playwright
+
+    node = Path(playwright.__file__).parent / "driver" / "node.exe"
+    if not node.is_file():
+        import shutil
+        fallback = shutil.which("node")
+        return {"node": {"path": fallback}} if fallback else {}
+    return {"node": {"path": str(node)}}
 
 
