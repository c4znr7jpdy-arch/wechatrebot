+    async def _search_title_candidates(
+        self,
+        session: aiohttp.ClientSession,
+        semaphore: asyncio.Semaphore,
+        query: str,
+        media_type: str | None,
+    ) -> list[SearchResult]:
+        """Try bounded metadata waves while preserving the original title match."""
+        deadline = time.monotonic() + _TITLE_SEARCH_TIMEOUT_SECONDS
+        candidates: list[SearchResult] = []
+        terms = (query, *fuzzy_search_terms(query)[:MAX_FALLBACK_TERMS])
+        for term in dict.fromkeys(terms):
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                break
+            completed: dict[int, list[SearchResult]] = {}
+
+            async def load_source(index: int, source: Source) -> None:
+                completed[index] = await self._search_source_variants(
+                    session, semaphore, source, term,
+                    match_query=query, media_type=media_type,
+                )
+
+            try:
+                await asyncio.wait_for(
+                    asyncio.gather(*(load_source(index, source)
+                                     for index, source in enumerate(self.sources))),
+                    timeout=remaining,
+                )
+            except asyncio.TimeoutError:
+                logger.info("[SHORT_DRAMA] title metadata deadline reached")
+            candidates = self._dedupe_results(
+                candidates + [item for index in sorted(completed)
+                              for item in completed[index]]
+            )
+            reliable, _ = candidate_pool(
+                (item for item in candidates if is_selectable_variant(item)),
+                min_fuzzy_score=self.min_fuzzy_score,
+            )
+            if reliable or time.monotonic() >= deadline:
+                break
+        return candidates
+
