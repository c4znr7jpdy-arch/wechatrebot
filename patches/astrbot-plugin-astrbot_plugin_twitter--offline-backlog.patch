+    async def prime_cursors(self) -> bool:
+        """为启动时已有订阅建立基线，跳过机器人离线期间的积压。"""
+        subscribe_list = await self.subscriptions.get_all()
+        if not subscribe_list:
+            return True
+
+        semaphore = asyncio.Semaphore(self.max_concurrent_authors)
+
+        async def prime_one(username: str, info: dict) -> bool:
+            async with semaphore:
+                try:
+                    latest_ids = await self.twitter_api.get_user_newtimeline(
+                        username
+                    )
+                    numeric_ids = [
+                        str(tweet_id).strip()
+                        for tweet_id in (latest_ids or [])
+                        if str(tweet_id).strip().isdigit()
+                    ]
+                    if not numeric_ids:
+                        return True
+
+                    latest_id = max(numeric_ids, key=int)
+                    current_id = str(info.get("since_id") or "").strip()
+                    if current_id.isdigit() and int(latest_id) <= int(current_id):
+                        return True
+
+                    await self.subscriptions.commit_processed_tweets(
+                        username,
+                        [latest_id],
+                        latest_id,
+                    )
+                    logger.info(
+                        f"@{username} 已建立推文启动基线，"
+                        f"跳过离线期间积压推文至 {latest_id}"
+                    )
+                    return True
+                except FxTwitterTimelineError as exc:
+                    logger.warning(
+                        f"@{username} 建立推文启动基线失败，"
+                        f"保留当前游标等待重试: {exc}"
+                    )
+                    return False
+                except Exception as exc:
+                    logger.error(
+                        f"@{username} 建立推文启动基线异常，"
+                        f"保留当前游标等待重试: {exc}"
+                    )
+                    return False
+
+        results = await asyncio.gather(
+            *(
+                prime_one(username, info)
+                for username, info in subscribe_list.items()
+            )
+        )
+        return all(results)
+
