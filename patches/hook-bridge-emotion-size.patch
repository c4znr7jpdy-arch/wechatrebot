--- /dev/null
+++ b/hook_41827_astrbot_bridge/src/hook_bridge/emotion_media.py
@@ -0,0 +1,61 @@
+"""Bound local stickers before handing them to HOOK's emotion endpoint."""
+from pathlib import Path
+
+from PIL import Image, ImageOps
+
+
+# Conservative delivery budget; leave headroom below the HOOK file downgrade.
+EMOTION_MAX_BYTES = 480 * 1024
+EMOTION_MAX_EDGE = 240
+_MAX_SOURCE_FRAMES = 1000
+
+
+def _palette_frame(frame: Image.Image, colors: int) -> Image.Image:
+    alpha = frame.getchannel("A")
+    result = frame.convert("RGB").quantize(colors=colors, method=Image.Quantize.MEDIANCUT)
+    result.paste(255, mask=alpha.point(lambda value: 255 if value < 128 else 0))
+    result.info["transparency"] = 255
+    return result
+
+
+def _write_gif(frames, durations, destination, *, edge, colors, stride, loop):
+    selected, timing = [], []
+    for start in range(0, len(frames), stride):
+        frame = frames[start].copy()
+        frame.thumbnail((edge, edge), Image.Resampling.LANCZOS)
+        selected.append(_palette_frame(frame, colors))
+        timing.append(sum(durations[start:start + stride]))
+    options = {"loop": loop} if loop is not None else {}
+    selected[0].save(
+        destination, format="GIF", save_all=True, append_images=selected[1:],
+        duration=timing, disposal=2, transparency=255, optimize=False, **options,
+    )
+
+
+def prepare_sticker(source: Path, destination: Path, max_bytes: int) -> None:
+    """Keep animation timing/transparency while reducing dimensions and palette.
+
+    Only the cache destination is written. Failure never sends the source as a file.
+    """
+    frames, durations = [], []
+    with Image.open(source) as image:
+        count = getattr(image, "n_frames", 1)
+        if count > _MAX_SOURCE_FRAMES:
+            raise ValueError("emotion has too many frames to safely convert")
+        loop = image.info.get("loop")
+        for index in range(count):
+            image.seek(index)
+            frame = ImageOps.exif_transpose(image).convert("RGBA")
+            frame.thumbnail((EMOTION_MAX_EDGE, EMOTION_MAX_EDGE), Image.Resampling.LANCZOS)
+            frames.append(frame)
+            durations.append(max(10, int(image.info.get("duration", 100))))
+    budget = min(max_bytes, EMOTION_MAX_BYTES)
+    for edge, colors, stride in ((240, 128, 1), (200, 96, 1), (160, 64, 2),
+                                 (120, 48, 3), (96, 32, 4), (64, 16, 6)):
+        # Preserve at least two sampled frames for animated inputs.
+        stride = min(stride, max(1, (len(frames) + 1) // 2))
+        _write_gif(frames, durations, destination, edge=edge, colors=colors,
+                   stride=stride, loop=loop)
+        if destination.stat().st_size <= budget:
+            return
+    raise ValueError("emotion cannot fit the sticker delivery budget")
