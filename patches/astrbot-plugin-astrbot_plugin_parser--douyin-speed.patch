+    def _download_video_once(
+        self, resource_key: str, video_url: str, headers: dict[str, str]
+    ) -> Task[Path]:
+        """Share an active or completed download across conversations."""
+        cached = self._video_downloads.get(resource_key)
+        if cached is not None:
+            if not cached.done() or (
+                not cached.cancelled()
+                and cached.exception() is None
+                and cached.result().is_file()
+            ):
+                self._video_downloads.move_to_end(resource_key)
+                return cached
+            self._video_downloads.pop(resource_key)
+
+        task = self.downloader.download_video(
+            video_url, headers=headers, proxy=self.proxy
+        )
+        self._video_downloads[resource_key] = task
+        if len(self._video_downloads) > 128:
+            self._video_downloads.popitem(last=False)
+        return task
+
