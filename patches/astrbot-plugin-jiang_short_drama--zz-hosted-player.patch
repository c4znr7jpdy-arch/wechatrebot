+    def _hosted_player_url(self, value: object) -> str | None:
+        """Accept only signed or stateless links on the configured player page."""
+        raw_base = str(
+            self.config.get("stateless_player_url") or ""
+        ).strip().rstrip("#")
+        raw_candidate = str(value or "").strip()
+        if (
+            len(raw_base) > 2048
+            or len(raw_candidate) > 2048
+            or any(ord(character) < 32 for character in raw_base + raw_candidate)
+        ):
+            return None
+        base = urlsplit(raw_base)
+        candidate = urlsplit(raw_candidate)
+        try:
+            hostname = (base.hostname or "").rstrip(".").lower()
+            try:
+                address = ipaddress.ip_address(hostname)
+            except ValueError:
+                labels = hostname.split(".")
+                public_host = (
+                    len(labels) >= 2
+                    and bool(re.search(r"[a-z]", labels[-1]))
+                    and hostname != "localhost"
+                    and not hostname.endswith((".localhost", ".local"))
+                    and all(
+                        re.fullmatch(
+                            r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",
+                            label,
+                        )
+                        for label in labels
+                    )
+                )
+            else:
+                public_host = address.is_global
+            same_endpoint = (
+                base.scheme == "https"
+                and bool(base.hostname)
+                and public_host
+                and not base.username
+                and not base.password
+                and not base.query
+                and not base.fragment
+                and candidate.scheme == "https"
+                and candidate.hostname == base.hostname
+                and candidate.port == base.port
+                and candidate.path == base.path
+                and not candidate.username
+                and not candidate.password
+            )
+        except ValueError:
+            return None
+        if not same_endpoint:
+            return None
+        if candidate.query:
+            if candidate.fragment or not re.fullmatch(
+                r"s=[A-Za-z0-9_-]{16,96}", candidate.query
+            ):
+                return None
+        elif not re.fullmatch(
+            r"(?:r=[A-Za-z0-9_-]{1,1800}|"
+            r"p=[A-Za-z0-9_-]{1,1800}&ep=[1-9]\d{0,4}&force=[01])",
+            candidate.fragment,
+        ):
+            return None
+        return candidate.geturl()
 
