+    async def _ensure_embedding_dimension(self) -> None:
+        """Discover an unspecified dimension before opening any existing index."""
+        provider = self.embedding_provider
+        if provider.get_dim() > 0:
+            return
+        try:
+            vector = await asyncio.wait_for(provider.get_embedding("dimension probe"), timeout=15.0)
+            if not isinstance(vector, list) or not vector or not all(
+                isinstance(value, (int, float)) and not isinstance(value, bool) for value in vector
+            ):
+                raise ValueError("invalid embedding")
+        except Exception:
+            raise ProviderNotReadyError("向量模型连接失败或未返回有效向量，请检查模型服务；原有记忆和索引未改动") from None
+        provider.provider_config["embedding_dimensions"] = len(vector)
 
