 from datetime import datetime
 from typing import TYPE_CHECKING
@@ -33,6 +34,62 @@ if TYPE_CHECKING:
 class MemoryRecall:
     """记忆召回类"""
 
+    _EXPLICIT_MEMORY_INTENT_RE = re.compile(
+        r"(记得|还记得|之前|上次|以前|当时|我说过|我喜欢|我叫|我是谁|谁是|哪天|什么时候|remember|last time|before)",
+        re.IGNORECASE,
+    )
+
+    _CASUAL_RE = re.compile(
+        r"^((?:你?好)+|在干嘛|干嘛|干吗|在吗|吃了吗|睡了吗|干啥|在干啥|早|早上好|下午好|晚上好|晚安|哈喽|喂+|哈哈+|嗯+|哦+|好的|行|可以|收到|谢谢|谢了|在呢|没干嘛|怎么了|啥事)[！!？?~。.]*$",
+        re.IGNORECASE,
+    )
+
+    def _should_auto_recall(self, query: str) -> tuple[bool, str]:
+        """Route only memory-bearing messages to long-term retrieval."""
+        mode = str(
+            self.config_manager.get("recall_engine.auto_recall_mode", "smart")
+            or "smart"
+        ).strip().lower()
+        if mode == "off":
+            return False, "auto_recall_off"
+        text = self._normalize_query_for_routing(query)
+        if not text:
+            return False, "empty_after_normalize"
+        if self._EXPLICIT_MEMORY_INTENT_RE.search(text):
+            return True, "explicit_memory_request"
+        if mode == "manual":
+            return False, "manual_no_explicit_request"
+        if mode == "always":
+            return True, "always"
+
+        max_chars = int(
+            self.config_manager.get("recall_engine.casual_query_max_chars", 24)
+            or 24
+        )
+        if len(text) <= max_chars and self._CASUAL_RE.fullmatch(text):
+            return False, "short_casual"
+        return True, "potential_memory_context"
+
+    @staticmethod
+    def _normalize_query_for_routing(query: str) -> str:
+        text = str(query or "").strip()
+        # Bridge/history prefixes are transport metadata, not the user's intent.
+        text = re.sub(r"^\[[^\]]{1,180}\]\s*", "", text)
+        text = re.sub(r"\[At:[^\]]+\]", "", text, flags=re.IGNORECASE)
+        text = text.replace("\u2005", " ").replace("\u200b", " ")
+        text = re.sub(r"\s+", " ", text).strip()
+        text = re.sub(r"^(?:@[^\s@]{1,40}\s*)+", "", text).strip()
+        return text
+
+    @staticmethod
+    def _set_recall_state(event: AstrMessageEvent, state: str, reason: str) -> None:
+        """Expose only bounded routing state; never expose message or memory text."""
+        if not hasattr(event, "set_extra"):
+            return
+        event.set_extra("livingmemory_recall", state in {"searching", "injected", "no_match"})
+        event.set_extra("livingmemory_recall_state", state)
+        event.set_extra("livingmemory_recall_reason", reason)
+
     def __init__(
         self,
         context,
