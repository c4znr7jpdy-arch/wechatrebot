+    async def _send_chain_with_hooks(self, session_id: str, components: list) -> bool:
+        """Decorate and send under the same verified account and current grants."""
+        from astrbot.core.platform.wechat_background_policy import (
+            background_event, send_background_message,
+        )
+
+        try:
+            authorized = await background_event(
+                self.context, session_id, "astrbot_plugin_proactive_chat",
+            )
+            if authorized[0].status != PlatformStatus.RUNNING:
+                logger.warning("Proactive platform is not running; delivery skipped.")
+                return False
+            processed = await self._trigger_decorating_hooks(
+                session_id, components, authorized=authorized,
+            )
+            if not processed:
+                return False
+            chain = MessageChain(processed)
+            sent = await send_background_message(
+                self.context, session_id, chain, "astrbot_plugin_proactive_chat",
+                authorized=authorized,
+            )
+            if sent and authorized[0].meta().id != "webchat":
+                await self._persist_proactive_message_to_platform_history(session_id, chain)
+            return bool(sent)
+        except PermissionError:
+            logger.info("Proactive permission revoked or account changed; delivery skipped.")
