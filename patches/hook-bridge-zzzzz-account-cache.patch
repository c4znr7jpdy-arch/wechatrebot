@@ -11,2 +14,44 @@ from .models import GroupMemberIdentity, RecallRecord, ReplyTarget
 
+class AccountChangedError(RuntimeError):
+    """An asynchronous operation still belongs to a previous account session."""
+
+
+_account_scope: ContextVar[tuple[object, int] | None] = ContextVar("bridge_account_scope", default=None)
+
+
+def ensure_current_account() -> None:
+    scope = _account_scope.get()
+    if scope is not None and getattr(scope[0], "account_epoch", 0) != scope[1]:
+        raise AccountChangedError("微信账号已变化，原账号操作已取消。")
+
+
+@contextmanager
+def account_scope(state):
+    inherited = _account_scope.get()
+    token = None
+    if inherited is None or inherited[0] is not state:
+        token = _account_scope.set((state, getattr(state, "account_epoch", 0)))
+    try:
+        ensure_current_account()
+        yield
+    finally:
+        if token is not None:
+            _account_scope.reset(token)
+
+
+def account_bound(function):
+    """Child tasks inherit the original epoch, including an A -> B -> A switch."""
+    @wraps(function)
+    async def bound(self, *args, **kwargs):
+        with account_scope(self.state):
+            event = args[0] if args else None
+            account = getattr(event, "account_id", "")
+            if account and self.state.bot_wxid and account != self.state.bot_wxid:
+                raise AccountChangedError("微信账号已变化，原账号事件已取消。")
+            result = await function(self, *args, **kwargs)
+            ensure_current_account()
+            return result
+    return bound
+
+
