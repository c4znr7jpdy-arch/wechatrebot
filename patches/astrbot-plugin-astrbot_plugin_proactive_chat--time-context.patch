+def format_current_time(tz: zoneinfo.ZoneInfo | None) -> str:
+    """Format an authoritative local date, weekday and timezone for LLM requests."""
+    now = datetime.now(tz) if tz else datetime.now().astimezone()
+    weekday = "一二三四五六日"[now.weekday()]
+    zone_name = getattr(now.tzinfo, "key", None) or now.tzname()
+    offset = now.strftime("%z")
+    return (
+        f"{now:%Y年%m月%d日} 星期{weekday} {now:%H:%M} "
+        f"({zone_name}, UTC{offset[:3]}:{offset[3:]})"
+    )
