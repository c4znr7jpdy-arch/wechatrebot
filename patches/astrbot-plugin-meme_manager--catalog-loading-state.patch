 }
 
+.catalog-status {
+  grid-column: span 12;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-height: 42px;
+  padding: 10px 14px;
+  border: 1px solid #cde5da;
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 0.9);
+  color: var(--muted);
+  font-size: 13px;
+}
+
+.catalog-status[hidden] {
+  display: none;
+}
+
+.catalog-status.error {
+  border-color: #edc2bc;
+  color: var(--danger);
+}
+
+.catalog-status .ghost {
+  flex: 0 0 auto;
+  padding: 7px 10px;
+}
+
 .official-zone {
   border-color: #ecd8a2;
   background: linear-gradient(180deg, #fffdf6 0%, #ffffff 100%);
 }
