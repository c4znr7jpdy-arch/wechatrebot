+    def _commercial_is_analysis_admin(self, event: AstrMessageEvent) -> bool:
+        if event.is_admin():
+            return True
+        basic = self.config.get("basic", {})
+        admins = basic.get("admin_ids", []) if isinstance(basic, dict) else []
+        if not isinstance(admins, list):
+            return False
+        sender_id = str(event.get_sender_id() or "").strip()
+        return bool(sender_id) and sender_id in {
+            value.strip() for value in admins if isinstance(value, str) and value.strip()
+        }
+
+    def _commercial_admin_denied(self, event: AstrMessageEvent) -> str:
+        sender_id = str(event.get_sender_id() or "未知")
+        return (
+            f"❌ 您没有群聊分析管理员权限（用户 ID：{sender_id}）。"
+            "请在“功能中心 → 群聊分析 → 常用设置”的“群聊分析管理员”列表中添加此用户 ID。"
+        )
+
