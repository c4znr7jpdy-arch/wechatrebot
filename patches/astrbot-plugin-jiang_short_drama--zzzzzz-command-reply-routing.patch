+def _is_wechat_group(event: AstrMessageEvent) -> bool:
+    return event.get_platform_name() == "aiocqhttp" and str(
+        event.get_group_id() or ""
+    ).endswith("@chatroom")
+
+
+def _interactive_card_payload(event: AstrMessageEvent, message: list[dict]) -> dict:
+    payload = {"message": message}
+    if _is_wechat_group(event):
+        # The card answers a command received in this group, not a scheduled send.
+        payload["_wechatrebot_delivery"] = "reply"
+        payload["_wechatrebot_wake"] = True
+    return payload
+
+
+def _mark_interactive_command(event: AstrMessageEvent) -> None:
+    if _is_wechat_group(event):
+        event.is_at_or_wake_command = True
+
+
