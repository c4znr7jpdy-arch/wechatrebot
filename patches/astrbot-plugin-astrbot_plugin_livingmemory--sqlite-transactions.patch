+    @asynccontextmanager
+    async def _write_transaction(self):
+        """串行执行主连接写事务，并保证任何失败都不会残留写锁。"""
+        async with self._db_write_lock:
+            connection = self.db_connection
+            if connection is None:
+                raise RuntimeError("memory database is not initialized")
+            try:
+                if connection.in_transaction:
+                    await connection.rollback()
+                await connection.execute("BEGIN IMMEDIATE")
+                yield connection
+                await connection.commit()
+            except BaseException:
+                # An interrupted BEGIN can already be queued by aiosqlite;
+                # queue rollback even when in_transaction has not changed yet.
+                await connection.rollback()
+                raise
