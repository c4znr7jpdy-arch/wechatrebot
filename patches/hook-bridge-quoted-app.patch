+def _quoted_app_text(value: str) -> str:
+    """Read the immediate app title without following an older nested quote."""
+    unavailable = "[引用消息内容不可用]"
+    root = _parse_xml_layers(value)
+    if root is None:
+        return unavailable
+    appmsg = root if _local_name(root.tag) == "appmsg" else next(
+        (node for node in root if _local_name(node.tag) == "appmsg"), None
+    )
+    if appmsg is None:
+        return unavailable
+    fields = {_local_name(node.tag): (node.text or "").strip() for node in appmsg}
+    title = fields.get("title", "")
+    if not title:
+        return unavailable
+    return title if fields.get("type") == "57" else f"[引用的应用消息] {title}"
+
