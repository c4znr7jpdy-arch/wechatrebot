new file mode 100644
index 0000000..df0a6f1
--- /dev/null
+++ b/hook_41827_astrbot_bridge/src/hook_bridge/history_original.py
@@ -0,0 +1,171 @@
+"""On-demand history images with a small, expiring cache and no journal blobs."""
+from __future__ import annotations
+
+import asyncio
+import base64
+from collections.abc import Mapping
+import hashlib
+import io
+import logging
+from pathlib import Path
+import re
+import time
+import warnings
+
+from PIL import Image
+
+from .history_media import image_preview
+from .inbound_image import ImageCdnCandidate, callback_image_candidates_from_payload
+
+
+logger = logging.getLogger(__name__)
+IMAGE_MAX_BYTES = 20 * 1024 * 1024
+CACHE_MAX_BYTES = 128 * 1024 * 1024
+CACHE_MAX_FILES = 16
+CACHE_TTL_SECONDS = 15 * 60
+_CACHE_NAME = re.compile(r"[a-f0-9]{64}(?:-[a-z0-9-]+)?\.img")
+
+
+def history_images(paths, raw=None) -> dict:
+    """Keep references aligned with thumbnails; never download or copy here."""
+    candidates = callback_image_candidates_from_payload(raw) if isinstance(raw, Mapping) else ()
+    originals = [
+        {"file_id": item.file_id, "aes_key": item.aes_key, "image_type": 1}
+        for item in candidates
+        if item.image_type == 1 and len(item.file_id) <= 8192 and len(item.aes_key) <= 256
+    ][:4]
+    previews, references = [], []
+    for path in list(paths)[:4]:
+        preview = image_preview(path)
+        if not preview:
+            continue
+        previews.append(preview)
+        references.append({"path": str(path.resolve()), "cdn": originals})
+    return {"media_previews": previews, "media_originals": references}
+
+
+def _image_data(path: Path, limit: int) -> str:
+    with path.open("rb") as handle:
+        raw = handle.read(limit + 1)
+    if not raw or len(raw) > limit:
+        raise ValueError("image is too large or empty")
+    with warnings.catch_warnings():
+        warnings.simplefilter("error", Image.DecompressionBombWarning)
+        with Image.open(io.BytesIO(raw)) as image:
+            mime = {"PNG": "png", "JPEG": "jpeg", "WEBP": "webp", "GIF": "gif"}.get(image.format)
+            if not mime or image.width * image.height > 20_000_000:
+                raise ValueError("unsupported history image")
+            image.verify()
+    return f"data:image/{mime};base64," + base64.b64encode(raw).decode("ascii")
+
+
+class HistoryOriginalImages:
+    def __init__(self, history, media_root: Path, download, max_bytes: int) -> None:
+        if max_bytes <= 0:
+            raise ValueError("max_bytes must be positive")
+        self.history = history
+        self.media_root = media_root.resolve()
+        self.root = self.media_root / "history-original"
+        self.download = download
+        self.max_bytes = min(max_bytes, IMAGE_MAX_BYTES)
+        self._pending: dict[str, asyncio.Task] = {}
+        self._active: set[str] = set()
+        self._download_lock = asyncio.Lock()
+
+    def cleanup(self, now: float | None = None) -> int:
+        if not self.root.is_dir() or self.root.resolve() != self.root:
+            return 0
+        current = time.time() if now is None else now
+        entries, removed = [], 0
+        for path in self.root.iterdir():
+            if (not _CACHE_NAME.fullmatch(path.name) or path.is_symlink()
+                    or not path.is_file() or path.name[:64] in self._active):
+                continue
+            try:
+                stat = path.stat()
+                if stat.st_mtime <= current - CACHE_TTL_SECONDS:
+                    path.unlink()
+                    removed += 1
+                else:
+                    entries.append((stat.st_mtime, path, stat.st_size))
+            except FileNotFoundError:
+                continue
+        entries.sort(reverse=True)
+        total = 0
+        for index, (_, path, size) in enumerate(entries):
+            total += size
+            if index >= CACHE_MAX_FILES or total > CACHE_MAX_BYTES:
+                path.unlink(missing_ok=True)
+                removed += 1
+        return removed
+
+    async def get(self, account: str, conversation: str, message_id: int, image_index: int) -> dict:
+        reference = self.history.image_reference(account, conversation, message_id, image_index)
+        key = hashlib.sha256(f"{account}\0{conversation}\0{message_id}\0{image_index}".encode()).hexdigest()
+        task = self._pending.get(key)
+        if task is None:
+            if len(self._pending) >= 4:
+                raise ValueError("图片正在加载，请稍后重试")
+            task = asyncio.create_task(self._load(key, reference))
+            self._pending[key] = task
+            def finished(completed):
+                self._pending.pop(key, None)
+                if not completed.cancelled():
+                    completed.exception()  # A closed viewer may stop awaiting this task.
+            task.add_done_callback(finished)
+        result = await asyncio.shield(task)
+        return {"message_id": message_id, "image_index": image_index, **result}
+
+    async def _load(self, key: str, reference: dict) -> dict:
+        try:
+            await asyncio.wait_for(self._download_lock.acquire(), timeout=1)
+        except asyncio.TimeoutError:
+            raise ValueError("图片正在加载，请稍后重试") from None
+        try:
+            self.cleanup()
+            if self.root.resolve() != self.root:
+                raise ValueError("图片缓存目录无效")
+            self.root.mkdir(parents=True, exist_ok=True)
+            destination = self.root / f"{key}.img"
+            if destination.is_file() and not destination.is_symlink():
+                try:
+                    return {"image_data_url": _image_data(destination, self.max_bytes), "quality": "original"}
+                except (OSError, ValueError, Image.DecompressionBombError, Image.DecompressionBombWarning):
+                    destination.unlink(missing_ok=True)
+            candidates = []
+            sources = reference.get("cdn", [])
+            for item in (sources[:4] if isinstance(sources, list) else []):
+                if (isinstance(item, dict) and item.get("image_type") == 1
+                        and isinstance(item.get("file_id"), str) and 0 < len(item["file_id"]) <= 8192
+                        and isinstance(item.get("aes_key"), str) and 0 < len(item["aes_key"]) <= 256):
+                    candidates.append(ImageCdnCandidate(item["file_id"], item["aes_key"], 1))
+            if candidates:
+                valid_download = False
+                self._active.add(key)
+                try:
+                    downloaded = await asyncio.wait_for(self.download(destination, tuple(candidates), key), timeout=15)
+                    if downloaded:
+                        image = _image_data(destination, self.max_bytes)
+                        valid_download = True
+                        return {"image_data_url": image, "quality": "original"}
+                except Exception:
+                    logger.warning("History original image download unavailable")
+                finally:
+                    self._active.discard(key)
+                    for path in self.root.glob(f"{key}-*.img"):
+                        path.unlink(missing_ok=True)
+                    # Invalid/partial destinations must never become cache hits.
+                    if not valid_download:
+                        destination.unlink(missing_ok=True)
+                    self.cleanup()
+            raw_path = reference.get("path")
+            if isinstance(raw_path, str) and raw_path:
+                path = Path(raw_path).resolve()
+                if path.is_relative_to(self.media_root) and not path.is_relative_to(self.root):
+                    try:
+                        return {"image_data_url": _image_data(path, self.max_bytes), "quality": "cached"}
+                    except (OSError, ValueError, Image.DecompressionBombError, Image.DecompressionBombWarning):
+                        logger.debug("History cached image unavailable")
+            raise FileNotFoundError("原图已失效或未记录，当前仅能查看缩略图")
+        finally:
+            self._download_lock.release()
