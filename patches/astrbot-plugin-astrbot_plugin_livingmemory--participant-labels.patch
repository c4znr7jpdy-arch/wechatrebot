+def _participant_identity_label(identity: Any) -> str:
+    """Reuse saved aliases and stable keys without exposing account identifiers."""
+    if not isinstance(identity, dict):
+        return ""
+    if identity.get("is_bot") is True:
+        return "我"
+
+    sender_value = identity.get("sender_id")
+    sender_id = (
+        str(sender_value).strip()
+        if isinstance(sender_value, (str, int)) and not isinstance(sender_value, bool)
+        else ""
+    )
+    key_value = identity.get("identity_key")
+    identity_key = key_value.strip() if isinstance(key_value, str) else ""
+    if not identity_key and sender_id:
+        platform_value = identity.get("platform")
+        platform = (
+            platform_value.strip().lower() if isinstance(platform_value, str) else ""
+        ) or "unknown"
+        identity_key = f"{platform}:{sender_id}"
+    if not identity_key:
+        return ""
+
+    name_value = identity.get("display_name")
+    display_name = name_value.strip() if isinstance(name_value, str) else ""
+    # Older rows used the full sender ID as a missing-name fallback. The saved
+    # key can still identify that account when sender_id itself is missing.
+    account_ids = (sender_id, identity_key.partition(":")[2] or identity_key)
+    if (
+        not display_name
+        or display_name == identity_key
+        or any(account and account.casefold() in display_name.casefold() for account in account_ids)
+    ):
+        display_name = "用户"
+    suffix = hashlib.sha256(identity_key.encode("utf-8")).hexdigest()[:8]
+    return f"{display_name}#{suffix}"
+
