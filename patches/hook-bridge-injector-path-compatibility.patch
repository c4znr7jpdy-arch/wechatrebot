 from .config import Settings, SettingsError
 
 
+def _native_file_argument(path: Path, label: str) -> str:
+    """The pinned injector widens argv bytes directly; native paths need ASCII."""
+    original = str(path)
+    if original.isascii():
+        return original
+    try:
+        api = ctypes.WinDLL("kernel32", use_last_error=True).GetShortPathNameW
+        api.argtypes = (wintypes.LPCWSTR, wintypes.LPWSTR, wintypes.DWORD)
+        api.restype = wintypes.DWORD
+        # API sizes count UTF-16 characters on Windows, including the NUL when
+        # querying capacity. Never size this buffer using Python string length.
+        capacity = api(original, None, 0)
+        for _ in range(2):
+            if not 0 < capacity <= 32768:
+                break
+            buffer = ctypes.create_unicode_buffer(capacity)
+            written = api(original, buffer, capacity)
+            if 0 < written < capacity:
+                alias = buffer.value
+                # Disabled 8.3 names may return the unchanged Unicode path.
+                # Require an existing file and matching identity, not spelling.
+                candidate = Path(alias)
+                if (
+                    alias.isascii() and candidate.is_absolute()
+                    and candidate.is_file() and path.samefile(candidate)
+                ):
+                    return alias
+                break
+            if not written:
+                break
+            capacity = written
+    except (AttributeError, OSError, ValueError):
+        pass
+    raise SettingsError(
+        f"{label}路径含有微信连接组件不支持的字符，且无法使用兼容短路径。"
+        "请调整为仅含英文、数字和常规符号的路径后重试。"
+    ) from None
+
