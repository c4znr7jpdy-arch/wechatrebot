 logger = logging.getLogger("jiang_short_drama")
+_MAX_REMOTE_BODY_BYTES = 5_000_000
+
+
+async def _read_bounded_body(
+    response: aiohttp.ClientResponse, limit: int = _MAX_REMOTE_BODY_BYTES
+) -> bytes:
+    """Read through EOF or one byte beyond the allowed size."""
+    body = bytearray()
+    while len(body) <= limit:
+        chunk = await response.content.read(min(65536, limit + 1 - len(body)))
+        if not chunk:
+            break
+        body.extend(chunk)
+    return bytes(body)
+
+
+def _safe_public_https_url(value: object) -> bool:
+    if not isinstance(value, str) or not value or len(value) > 2048:
+        return False
+    if any(ord(character) < 32 for character in value):
+        return False
+    try:
+        parsed = urlsplit(value)
+        hostname = (parsed.hostname or "").rstrip(".").lower()
+        parsed.port
+        if (
+            parsed.scheme != "https"
+            or not parsed.netloc
+            or parsed.username
+            or parsed.password
+            or hostname == "localhost"
+            or hostname.endswith((".localhost", ".local"))
+        ):
+            return False
+        try:
+            address = ipaddress.ip_address(hostname)
+        except ValueError:
+            labels = hostname.split(".")
+            return (
+                len(labels) >= 2
+                and bool(re.search(r"[a-z]", labels[-1]))
+                and all(
+                    re.fullmatch(
+                        r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",
+                        label,
+                    )
+                    for label in labels
+                )
+            )
+        return address.version == 4 and address.is_global and not address.is_multicast
+    except ValueError:
+        return False
+
+
+class _PublicResolver(AbstractResolver):
+    """Resolve only globally routable addresses at connection time."""
+
+    def __init__(self, resolver: AbstractResolver | None = None) -> None:
+        self._resolver = resolver or DefaultResolver()
+
+    async def resolve(
+        self,
+        hostname: str,
+        port: int = 0,
+        family: int = socket.AF_INET,
+    ) -> list[Any]:
+        resolved = await self._resolver.resolve(hostname, port, family)
+        if not resolved:
+            raise OSError("host did not resolve")
+        for item in resolved:
+            raw_host = item.get("host") if isinstance(item, dict) else getattr(
+                item, "host", ""
+            )
+            raw_address = str(raw_host or "").split("%", 1)[0]
+            try:
+                address = ipaddress.ip_address(raw_address)
+            except ValueError as exc:
+                raise OSError("resolver returned an invalid address") from exc
+            if not address.is_global or address.is_multicast:
+                raise OSError("host resolved to a non-public address")
+        return resolved
+
+    async def close(self) -> None:
+        await self._resolver.close()
+
+
+def _public_connector() -> aiohttp.TCPConnector:
+    return aiohttp.TCPConnector(
+        resolver=_PublicResolver(),
+        ttl_dns_cache=60,
+    )
 
 
