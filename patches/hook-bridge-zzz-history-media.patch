@@ -0,0 +1,41 @@
+"""Bounded static history previews; never fetch media again for the journal."""
+from __future__ import annotations
+
+import base64
+import io
+import logging
+from pathlib import Path
+import warnings
+
+from PIL import Image, ImageOps
+
+logger = logging.getLogger(__name__)
+
+
+def image_preview(path: Path | None) -> str:
+    if path is None:
+        return ""
+    try:
+        if path.stat().st_size > 20 * 1024 * 1024:
+            return ""
+        with warnings.catch_warnings():
+            warnings.simplefilter("error", Image.DecompressionBombWarning)
+            with Image.open(path) as source:
+                if source.width * source.height > 20_000_000:
+                    return ""
+                source.seek(0)
+                frame = ImageOps.exif_transpose(source).convert("RGBA")
+                frame.thumbnail((320, 240))
+                output = io.BytesIO()
+                frame.save(output, format="WEBP", quality=75)
+        raw = output.getvalue()
+        if len(raw) > 64 * 1024:
+            return ""
+        return "data:image/webp;base64," + base64.b64encode(raw).decode("ascii")
+    except (OSError, ValueError, Image.DecompressionBombError, Image.DecompressionBombWarning):
+        logger.debug("History image preview unavailable", exc_info=False)
+        return ""
+
+
+def message_previews(paths) -> list[str]:
+    return [preview for path in list(paths)[:4] if (preview := image_preview(path))]
