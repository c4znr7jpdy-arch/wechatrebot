+    async def _download_native_media(
+        self,
+        download: Callable[[Mapping[str, Any]], Awaitable[Any]],
+        payload: Mapping[str, Any],
+        destination: Path,
+        expected_size: int,
+        message_id: str,
+        *,
+        timeout_seconds: float,
+    ) -> tuple[Any, bool, int | None]:
+        """Track one native download until its bounded file wait finishes."""
+        timeout_seconds = max(0.001, float(timeout_seconds))
+        loop = asyncio.get_running_loop()
+        deadline = loop.time() + timeout_seconds
+        self._native_download_generation += 1
+        self._active_native_downloads += 1
+        try:
+            try:
+                response = await asyncio.wait_for(download(payload), timeout_seconds)
+            except (ClientConnectionError, HookApiError, asyncio.TimeoutError) as exc:
+                # A native download may outlive its HTTP connection. Never
+                # start it twice or remove a file still owned by the DLL.
+                if not destination.is_file():
+                    await asyncio.sleep(min(0.2, max(0.0, deadline - loop.time())))
+                if not destination.is_file():
+                    raise
+                logger.warning(
+                    "HOOK native download endpoint disconnected after starting message=%s; "
+                    "waiting for the native download to finish error=%s",
+                    message_id,
+                    type(exc).__name__,
+                )
+                response = {
+                    "status": "download_in_progress_after_disconnect",
+                    "error_type": type(exc).__name__,
+                }
+            complete, actual_size = await self._wait_for_media_download(
+                destination,
+                expected_size,
+                timeout_seconds=max(0.001, deadline - loop.time()),
+            )
+            return response, complete, actual_size
+        finally:
+            self._active_native_downloads -= 1
