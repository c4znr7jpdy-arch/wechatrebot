[Unit]
Description=workbuddy.ai -> OpenAI protocol normalizer (for new-api channel)
Documentation=file:/opt/wb-relay/wb_relay.py
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wb-relay
ExecStart=/usr/bin/python3 -u /opt/wb-relay/wb_relay.py
Restart=always
RestartSec=3

# 绑定 docker0 网关，容器可达、外网不可达
Environment=WB_LISTEN_HOST=172.18.0.1,0.0.0.0
Environment=WB_LISTEN_PORT=3010
Environment=WB_HOST=www.workbuddy.ai
Environment=WB_PATH=/v2/chat/completions
Environment=WB_MODELS=deepseek-v4.1-flash,hy3,hy4-preview
Environment="WB_SYSTEM_PROMPT=You are a helpful assistant."
Environment=WB_MAX_RETRY=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wb-relay

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
