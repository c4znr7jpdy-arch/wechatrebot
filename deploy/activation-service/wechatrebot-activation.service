[Unit]
Description=WeChatReBot activation service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/wechatrebot-activation.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=40
ExecStart=/usr/bin/docker run --rm --name wechatrebot-activation --user ${ACTIVATION_USER} --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --cap-drop ALL --security-opt no-new-privileges --memory 192m --memory-swap 192m --cpus 0.5 --pids-limit 64 --publish 127.0.0.1:8091:8091 --mount type=bind,source=/var/lib/wechatrebot-activation,target=/data --log-opt max-size=5m --log-opt max-file=2 ${ACTIVATION_IMAGE}
ExecStop=/usr/bin/docker stop --time 30 wechatrebot-activation

[Install]
WantedBy=multi-user.target
