[Unit]
Description=Private online backup of WeChatReBot activation data
After=wechatrebot-activation.service

[Service]
Type=oneshot
User=wechatrebot-activation
Group=wechatrebot-activation
UMask=0077
ExecStart=/usr/bin/python3 /opt/wechatrebot-activation/deploy/activation-service/backup.py
TimeoutStartSec=300
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
